# EduAgent Interview Coach - Environment Configuration Template
# Copy this file to .env for local configuration. Never commit real credentials to version control.
# Hackathon Track: "Build, Ship, Shape" Amazon Developer Hackathon — Alexa+ (MCP Agent Skills)

# Application evaluation mode: "local" (default offline evaluation)
EVALUATION_MODE=local

# Alexa+ MCP Server Settings (Model Context Protocol)
MCP_SERVER_HOST=127.0.0.1
MCP_SERVER_PORT=8000
MCP_TRANSPORT=stdio

